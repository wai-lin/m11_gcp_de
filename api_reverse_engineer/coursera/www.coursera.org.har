            "text": "[{\"operationName\":\"SeoPathConfigurationQuery\",\"variables\":{\"path\":\"www.coursera.org/search?query=crypto\"},\"query\":\"query SeoPathConfigurationQuery($path: String!) {\\n  Seo {\\n    seoPathConfigurationQuery(path: $path) {\\n      id\\n      pageData {\\n        id\\n        globalFooter {\\n          categories {\\n            header\\n            id\\n            links {\\n              href\\n              id\\n              label\\n              __typename\\n            }\\n            __typename\\n          }\\n          id\\n          __typename\\n        }\\n        subfooter {\\n          categories {\\n            header\\n            id\\n            links {\\n              href\\n              id\\n              label\\n              __typename\\n            }\\n            __typename\\n          }\\n          id\\n          __typename\\n        }\\n        metaTags {\\n          canonicalURL\\n          descriptionTag\\n          disableCrawlerIndexing\\n          disableCrawlerFollow\\n          disableCrawlerAI\\n          maxImagePreview\\n          hreflangLinks {\\n            href\\n            hreflang\\n            id\\n            __typename\\n          }\\n          id\\n          titleTag\\n          __typename\\n        }\\n        megaMenu {\\n          id\\n          categories {\\n            id\\n            header\\n            subcategories {\\n              id\\n              header\\n              links {\\n                id\\n                href\\n                label\\n                __typename\\n              }\\n              __typename\\n            }\\n            __typename\\n          }\\n          __typename\\n        }\\n        __typename\\n      }\\n      eqpData {\\n        ...SeoPathConfigurationQuery_EqpData\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment SeoPathConfigurationQuery_EqpData on Seo_EqpData {\\n  id\\n  url\\n  titleTag\\n  descriptionTag\\n  filters {\\n    id\\n    field\\n    value\\n    __typename\\n  }\\n  headers {\\n    id\\n    searchResultsHeader {\\n      id\\n      label\\n      __typename\\n    }\\n    relatedSearchHeader {\\n      id\\n      label\\n      links {\\n        id\\n        label\\n        href\\n        __typename\\n      }\\n      __typename\\n    }\\n    domainSkillsHeader {\\n      id\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n  faqSlug\\n  topContentBlock {\\n    id\\n    label\\n    content\\n    __typename\\n  }\\n  bottomContentBlock {\\n    id\\n    label\\n    content\\n    __typename\\n  }\\n  __typename\\n}\\n\"}]"
