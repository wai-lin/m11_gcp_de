            "text": "[{\"year\":2024,\"modules\":[{\"module_number\":1,\"courses\":[{\"id\":982,\"title\":\"From Zero to Hero\",\"code\":\"HTE401BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-08-19\",\"end_date\":\"2024-09-06\",\"program\":{\"id\":7,\"name\":\"High-tech Entrepreneurship\",\"code\":\"HTE\",\"degree\":\"Bachelor\",\"campus\":\"BKK\",\"duration\":3,\"credits\":180,\"credits_for_major\":60,\"credits_for_minor\":32,\"tuition_fee\":19900,\"description\":null,\"title\":\"Bachelor of Business Administration\"},\"time\":\"13:00:00\",\"classroom\":\"Open.Space\",\"academic_year\":\"2024\",\"module_number\":1,\"type\":null,\"result\":{\"grade\":87,\"feedback\":\"-\"},\"teachers\":[{\"full_name\":\"Kamran Elahian\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2768\\/conversions\\/596-thumb.jpg\",\"position\":\"Founder & Chairman at Global Innovation Catalyst\"}]}]},{\"module_number\":2,\"courses\":[{\"id\":989,\"title\":\"Basics of Databases\",\"code\":\"CS202BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-09-09\",\"end_date\":\"2024-09-27\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":2,\"type\":null,\"result\":{\"grade\":95,\"feedback\":\"Hi Aung! Glad to see you on the course - thank you for the participation in our discussions, I really appreciate it! And your final project is impressive also.  I\\u2019m sure you have excellent career prospects\\u2014whether in IT or other fields where you can apply your skills to achieve success. You know, the most exciting things today are happening at the intersection of different areas of knowledge and skills. I wish you all the best, and hope to see you again!\"},\"teachers\":[{\"full_name\":\"Serhii Denysov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2672\\/conversions\\/437-thumb.jpg\",\"position\":\"Lecturer at Kyiv National Taras Shevchenko University\"}]}]},{\"module_number\":3,\"courses\":[{\"id\":1000,\"title\":\"Calculus 1\",\"code\":\"Math103BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-09-30\",\"end_date\":\"2024-10-18\",\"program\":{\"id\":24,\"name\":\"Maths as a Second Language\",\"code\":\"Math\",\"degree\":\"Foundation\",\"campus\":\"BCN\",\"duration\":1,\"credits\":60,\"credits_for_major\":0,\"credits_for_minor\":0,\"tuition_fee\":11900,\"description\":null,\"title\":null},\"time\":\"17:00:00\",\"classroom\":\"Interactive.Space\",\"academic_year\":\"2024\",\"module_number\":3,\"type\":null,\"result\":{\"grade\":72,\"feedback\":\"Great progress! Your hard work and effort to keep up with the class have really paid off. Keep pushing forward\"},\"teachers\":[{\"full_name\":\"Mohammad Sanaee Namaghi\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3215\\/conversions\\/587-thumb.jpg\",\"position\":\"Data Scientist at B.Grimm Power\"}]}]},{\"module_number\":4,\"courses\":[{\"id\":994,\"title\":\"Intro to Programming 2: Python\",\"code\":\"CS104BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-10-21\",\"end_date\":\"2024-11-08\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Venture.Space\",\"academic_year\":\"2024\",\"module_number\":4,\"type\":null,\"result\":{\"grade\":100,\"feedback\":\"Congratulations on your outstanding performance in this course! Your ability to consistently excel is commendable, and I hope the knowledge you\\u2019ve gained here will help you in the future at some point :)\"},\"teachers\":[{\"full_name\":\"Vetit Kanjaras\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3133\\/conversions\\/352-thumb.jpg\",\"position\":\"AI Engineer at SKY ICT PCL\"}]}]},{\"module_number\":5,\"courses\":[{\"id\":1020,\"title\":\"Combinatorics & Graphs\",\"code\":\"Math105BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-11-11\",\"end_date\":\"2024-11-29\",\"program\":{\"id\":24,\"name\":\"Maths as a Second Language\",\"code\":\"Math\",\"degree\":\"Foundation\",\"campus\":\"BCN\",\"duration\":1,\"credits\":60,\"credits_for_major\":0,\"credits_for_minor\":0,\"tuition_fee\":11900,\"description\":null,\"title\":null},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":5,\"type\":null,\"result\":{\"grade\":86,\"feedback\":\"Wai Lin was extremely involved in the study processes of the course, not just doing all the hometasks without any flaws, but also asking questions, solving in class, etc. Thanks!\"},\"teachers\":[{\"full_name\":\"Andrey Gavrilyuk\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3014\\/conversions\\/861-thumb.jpg\",\"position\":\"Team leader of the HSE team\"}]}]},{\"module_number\":6,\"courses\":[{\"id\":1027,\"title\":\"Intro to Machine Learning\",\"code\":\"DS206BKK\",\"credits\":4,\"status\":\"failed\",\"student_feedback_submitted\":true,\"start_date\":\"2024-12-02\",\"end_date\":\"2024-12-20\",\"program\":{\"id\":20,\"name\":\"Data Science\",\"code\":\"DS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22