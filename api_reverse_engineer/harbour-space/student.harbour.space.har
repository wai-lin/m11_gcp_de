            "text": "[{\"year\":2024,\"modules\":[{\"module_number\":1,\"courses\":[{\"id\":982,\"title\":\"From Zero to Hero\",\"code\":\"HTE401BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-08-19\",\"end_date\":\"2024-09-06\",\"program\":{\"id\":7,\"name\":\"High-tech Entrepreneurship\",\"code\":\"HTE\",\"degree\":\"Bachelor\",\"campus\":\"BKK\",\"duration\":3,\"credits\":180,\"credits_for_major\":60,\"credits_for_minor\":32,\"tuition_fee\":19900,\"description\":null,\"title\":\"Bachelor of Business Administration\"},\"time\":\"13:00:00\",\"classroom\":\"Open.Space\",\"academic_year\":\"2024\",\"module_number\":1,\"type\":null,\"result\":{\"grade\":87,\"feedback\":\"-\"},\"teachers\":[{\"full_name\":\"Kamran Elahian\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2768\\/conversions\\/596-thumb.jpg\",\"position\":\"Founder & Chairman at Global Innovation Catalyst\"}]}]},{\"module_number\":2,\"courses\":[{\"id\":989,\"title\":\"Basics of Databases\",\"code\":\"CS202BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-09-09\",\"end_date\":\"2024-09-27\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":2,\"type\":null,\"result\":{\"grade\":95,\"feedback\":\"Hi Aung! Glad to see you on the course - thank you for the participation in our discussions, I really appreciate it! And your final project is impressive also.  I\\u2019m sure you have excellent career prospects\\u2014whether in IT or other fields where you can apply your skills to achieve success. You know, the most exciting things today are happening a