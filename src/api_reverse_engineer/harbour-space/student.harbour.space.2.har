            "mimeType": "application/json",
            "text": "[{\"year\":2024,\"modules\":[{\"module_number\":1,\"courses\":[{\"id\":982,\"title\":\"From Zero to Hero\",\"code\":\"HTE401BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-08-19\",\"end_date\":\"2024-09-06\",\"program\":{\"id\":7,\"name\":\"High-tech Entrepreneurship\",\"code\":\"HTE\",\"degree\":\"Bachelor\",\"campus\":\"BKK\",\"duration\":3,\"credits\":180,\"credits_for_major\":60,\"credits_for_minor\":32,\"tuition_fee\":19900,\"description\":null,\"title\":\"Bachelor of Business Administration\"},\"time\":\"13:00:00\",\"classroom\":\"Open.Space\",\"academic_year\":\"2024\",\"module_number\":1,\"type\":null,\"result\":{\"grade\":87,\"feedback\":\"-\"},\"teachers\":[{\"full_name\":\"Kamran Elahian\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2768\\/conversions\\/596-thumb.jpg\",\"position\":\"Founder & Chairman at Global Innovation Catalyst\"}]}]},{\"module_number\":2,\"courses\":[{\"id\":989,\"title\":\"Basics of Databases\",\"code\":\"CS202BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-09-09\",\"end_date\":\"2024-09-27\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":2,\"type\":null,\"result\":{\"grade\":95,\"feedback\":\"Hi Aung! Glad to see you on the course - thank you for the participation in our discussions, I really appreciate it! And your final project is impressive also.  I\\u2019m sure you have excellent career prospects\\u2014whether in IT or other fields where you can apply your skills to achieve success. You know, the most exciting things today are happening at the intersection of different areas of knowledge and skills. I wish you all the best, and hope to see you again!\"},\"teachers\":[{\"full_name\":\"Serhii Denysov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2672\\/conversions\\/437-thumb.jpg\",\"position\":\"Lecturer at Kyiv National Taras Shevchenko University\"}]}]},{\"module_number\":3,\"courses\":[{\"id\":1000,\"title\":\"Calculus 1\",\"code\":\"Math103BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-09-30\",\"end_date\":\"2024-10-18\",\"program\":{\"id\":24,\"name\":\"Maths as a Second Language\",\"code\":\"Math\",\"degree\":\"Foundation\",\"campus\":\"BCN\",\"duration\":1,\"credits\":60,\"credits_for_major\":0,\"credits_for_minor\":0,\"tuition_fee\":11900,\"description\":null,\"title\":null},\"time\":\"17:00:00\",\"classroom\":\"Interactive.Space\",\"academic_year\":\"2024\",\"module_number\":3,\"type\":null,\"result\":{\"grade\":72,\"feedback\":\"Great progress! Your hard work and effort to keep up with the class have really paid off. Keep pushing forward\"},\"teachers\":[{\"full_name\":\"Mohammad Sanaee Namaghi\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3215\\/conversions\\/587-thumb.jpg\",\"position\":\"Data Scientist at B.Grimm Power\"}]}]},{\"module_number\":4,\"courses\":[{\"id\":994,\"title\":\"Intro to Programming 2: Python\",\"code\":\"CS104BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-10-21\",\"end_date\":\"2024-11-08\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Venture.Space\",\"academic_year\":\"2024\",\"module_number\":4,\"type\":null,\"result\":{\"grade\":100,\"feedback\":\"Congratulations on your outstanding performance in this course! Your ability to consistently excel is commendable, and I hope the knowledge you\\u2019ve gained here will help you in the future at some point :)\"},\"teachers\":[{\"full_name\":\"Vetit Kanjaras\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3133\\/conversions\\/352-thumb.jpg\",\"position\":\"AI Engineer at SKY ICT PCL\"}]}]},{\"module_number\":5,\"courses\":[{\"id\":1020,\"title\":\"Combinatorics & Graphs\",\"code\":\"Math105BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2024-11-11\",\"end_date\":\"2024-11-29\",\"program\":{\"id\":24,\"name\":\"Maths as a Second Language\",\"code\":\"Math\",\"degree\":\"Foundation\",\"campus\":\"BCN\",\"duration\":1,\"credits\":60,\"credits_for_major\":0,\"credits_for_minor\":0,\"tuition_fee\":11900,\"description\":null,\"title\":null},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":5,\"type\":null,\"result\":{\"grade\":86,\"feedback\":\"Wai Lin was extremely involved in the study processes of the course, not just doing all the hometasks without any flaws, but also asking questions, solving in class, etc. Thanks!\"},\"teachers\":[{\"full_name\":\"Andrey Gavrilyuk\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3014\\/conversions\\/861-thumb.jpg\",\"position\":\"Team leader of the HSE team\"}]}]},{\"module_number\":6,\"courses\":[{\"id\":1027,\"title\":\"Intro to Machine Learning\",\"code\":\"DS206BKK\",\"credits\":4,\"status\":\"failed\",\"student_feedback_submitted\":true,\"start_date\":\"2024-12-02\",\"end_date\":\"2024-12-20\",\"program\":{\"id\":20,\"name\":\"Data Science\",\"code\":\"DS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":6,\"type\":null,\"result\":{\"grade\":51,\"feedback\":\"You should invest and plan more time for your homework\"},\"teachers\":[{\"full_name\":\"Mikhail Romanov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2783\\/conversions\\/612-thumb.jpg\",\"position\":\"Samsung AI Center Moscow (SAIC Moscow), Researcher, R&D Engineer, Team Leader\\nMoscow Institute on Physics and Technology (MIPT), Expert\"}]}]},{\"module_number\":7,\"courses\":[{\"id\":1048,\"title\":\"From Data to Knowledge: Interpretation, Visualization, Presentation\",\"code\":\"DS307BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-01-13\",\"end_date\":\"2025-01-31\",\"program\":{\"id\":20,\"name\":\"Data Science\",\"code\":\"DS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":7,\"type\":null,\"result\":{\"grade\":80,\"feedback\":\"Dear Wai, I really appreciate the work you have done in my module (an assisting me during the classes). It has been a enormous pleasure to have you participating of this module. You are a hard-working guy and I have no doubt you have a brilliant professional future ahead. Please, don't hesitate to drop me an email if I can assist you in any way in the future. Also, let me know if you visit Barcelona in the future.\"},\"teachers\":[{\"full_name\":\"Juan Galeano\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2855\\/conversions\\/685-thumb.jpg\",\"position\":\"Post-doctoral researcher at the National Center of Competence in Research (NCCR), Uni- versit\\u00e9 de Gen\\u00e8ve (UNIGE)\"}]}]},{\"module_number\":8,\"courses\":[{\"id\":1068,\"title\":\"Programming: Kotlin\",\"code\":\"CS208BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-02-03\",\"end_date\":\"2025-02-21\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Data.Space\",\"academic_year\":\"2024\",\"module_number\":8,\"type\":null,\"result\":{\"grade\":93,\"feedback\":\"Wai Lin, thank you for active participation in the class. I don't have many more comments beyond what I already provided in the project review. Keep up the good work.\"},\"teachers\":[{\"full_name\":\"Monika Protivova\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3485\\/conversions\\/412ea680-aee9-11ee-b654-255d6a9b83cd-thumb.jpg\",\"position\":\"Software Engineer at CleverFarm\"}]}]},{\"module_number\":9,\"courses\":[{\"id\":1062,\"title\":\"Intro to Web Development\",\"code\":\"CS309BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-02-24\",\"end_date\":\"2025-03-14\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"17:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":9,\"type\":null,\"result\":{\"grade\":90,\"feedback\":\"Congratulations with your result. You are a very silent but skilled worker. I like the way how you made your application grow almost daily, and that you managed to bring it to a rather polished final project. Your app is pretty complete, and you are aware of the strengths and weaknesses. You manage to reason when further questions are asked, and proved that you have insights in your app structure and architecture. Also really cool that you managed to deploy it on laravel.cloud, which demonstrates that you dare to experiment. I wish you a lot of luck in your next steps, just make sure to look for enough challenges, so that you maximise your potential self-development.\"},\"teachers\":[{\"full_name\":\"Nico Deblauwe\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2790\\/conversions\\/620-thumb.jpg\",\"position\":\"Freelance Full Stack Developer\"}]}]},{\"module_number\":10,\"courses\":[{\"id\":1056,\"title\":\"Algorithms and Data Structures\",\"code\":\"CS210BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-03-17\",\"end_date\":\"2025-04-04\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Data.Space\",\"academic_year\":\"2024\",\"module_number\":10,\"type\":null,\"result\":{\"grade\":98,\"feedback\":\"Very good result. Solved most of Home Assignments and answered the exam perfectly.\"},\"teachers\":[{\"full_name\":\"Ivan Solomatin\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3258\\/conversions\\/064abfd0-c4c1-11ed-ac18-61342f1280cc-thumb.jpg\",\"position\":\"Leading Engineer at Samsung R&D Institute Russia.\"}]}]},{\"module_number\":11,\"courses\":[{\"id\":1148,\"title\":\"Fundamentals of Blockchain\",\"code\":\"CS411BKK\",\"credits\":6,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-04-28\",\"end_date\":\"2025-05-16\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":11,\"type\":null,\"result\":{\"grade\":93,\"feedback\":\"Great project! Thank you. \\n\\nTaking off some points because of progress and project management.\"},\"teachers\":[{\"full_name\":\"Bulat Nasrulin\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3517\\/conversions\\/17cfbf30-b6ef-11ee-a12a-17ac32f29c48-thumb.jpg\",\"position\":\"PostDoc Researcher Distributed Systems at TU Delft\"}]}]},{\"module_number\":12,\"courses\":[{\"id\":1155,\"title\":\"Intro to Deep Learning\",\"code\":\"DS212BKK\",\"credits\":4,\"status\":\"incomplete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-05-19\",\"end_date\":\"2025-06-06\",\"program\":{\"id\":20,\"name\":\"Data Science\",\"code\":\"DS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"12:30:00\",\"classroom\":\"Data.Space\",\"academic_year\":\"2024\",\"module_number\":12,\"type\":null,\"result\":{\"grade\":null,\"feedback\":null},\"teachers\":[{\"full_name\":\"Mikhail Romanov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2783\\/conversions\\/612-thumb.jpg\",\"position\":\"Samsung AI Center Moscow (SAIC Moscow), Researcher, R&D Engineer, Team Leader\\nMoscow Institute on Physics and Technology (MIPT), Expert\"}]}]},{\"module_number\":13,\"courses\":[{\"id\":1138,\"title\":\"Unity Game Development\",\"code\":\"CS213\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-06-30\",\"end_date\":\"2025-07-18\",\"program\":{\"id\":16,\"name\":\"Computer Science\",\"code\":\"CS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"17:00:00\",\"classroom\":\"Hyper.Space\",\"academic_year\":\"2024\",\"module_number\":13,\"type\":null,\"result\":{\"grade\":71,\"feedback\":\"Active participation despite remote connection to classes. Good final project.\"},\"teachers\":[{\"full_name\":\"Anton Baranov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3565\\/conversions\\/2b05fdc0-169d-11ef-a9d5-6512d38ed8ec-thumb.jpg\",\"position\":\"CTO at EnterAR LLP\"}]},{\"id\":1162,\"title\":\"Engineering and MLOps practices for Modern AI\",\"code\":\"DS313BKK\",\"credits\":6,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-06-09\",\"end_date\":\"2025-06-27\",\"program\":{\"id\":20,\"name\":\"Data Science\",\"code\":\"DS\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"13:00:00\",\"classroom\":\"Data.Space\",\"academic_year\":\"2024\",\"module_number\":13,\"type\":null,\"result\":{\"grade\":90,\"feedback\":\"Aung is a patient engineer and an exceptional team player who demonstrated remarkable dedication throughout the course. He contributed significantly to his project's success, especially when his teammate was absent, showing reliability and leadership when needed. \\n\\nAung is smart with strong attention to detail and excellent listening skills, making him highly effective in collaborative environments. He remained actively engaged during class discussions and consistently provided thoughtful contributions. His combination of technical competence, patience, collaborative spirit, and strong communication skills earned him very positive feedback and makes him an ideal candidate for team-based engineering roles.\"},\"teachers\":[{\"full_name\":\"Mikhail Rozhkov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3566\\/conversions\\/14f3d0c0-3ac5-11ef-845d-bf9f2d9fa3d0-thumb.jpg\",\"position\":\"Co-Founder of Machine Learning REPA Community and ML REPA School\"}]},{\"id\":1161,\"title\":\"Linear Algebra 1\",\"code\":\"Math113BKK\",\"credits\":4,\"status\":\"audit\",\"student_feedback_submitted\":false,\"start_date\":\"2025-06-09\",\"end_date\":\"2025-06-27\",\"program\":{\"id\":24,\"name\":\"Maths as a Second Language\",\"code\":\"Math\",\"degree\":\"Foundation\",\"campus\":\"BCN\",\"duration\":1,\"credits\":60,\"credits_for_major\":0,\"credits_for_minor\":0,\"tuition_fee\":11900,\"description\":null,\"title\":null},\"time\":\"09:00:00\",\"classroom\":\"Growth.Space\",\"academic_year\":\"2024\",\"module_number\":13,\"type\":null,\"result\":{\"grade\":null,\"feedback\":null},\"teachers\":[{\"full_name\":\"Mikhail Romanov\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/2783\\/conversions\\/612-thumb.jpg\",\"position\":\"Samsung AI Center Moscow (SAIC Moscow), Researcher, R&D Engineer, Team Leader\\nMoscow Institute on Physics and Technology (MIPT), Expert\"}]}]},{\"module_number\":14,\"courses\":[{\"id\":1142,\"title\":\"WebGL in Practice\",\"code\":\"FE414\",\"credits\":6,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-07-21\",\"end_date\":\"2025-08-08\",\"program\":{\"id\":17,\"name\":\"Front-end Development\",\"code\":\"FE\",\"degree\":\"Bachelor\",\"campus\":\"BCN\",\"duration\":3,\"credits\":180,\"credits_for_major\":60,\"credits_for_minor\":32,\"tuition_fee\":19900,\"description\":null,\"title\":\"Bachelor of Engineering\"},\"time\":\"17:00:00\",\"classroom\":\"Hyper.Space\",\"academic_year\":\"2024\",\"module_number\":14,\"type\":null,\"result\":{\"grade\":91,\"feedback\":\"Positively surprised on how you had some real progress on the topic itself, especially on how hard you push the final one looking to new features (onBeforeCompile) and the effort you have put in the final project. Too bad tho you were online, would have been better to have you IRL because pretty sure you could have add a positive boost to everyone.\"},\"teachers\":[{\"full_name\":\"Roberto Borghesi\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3282\\/conversions\\/aa567110-e1ee-11ed-9fb0-31f3f9ae8c3a-thumb.jpg\",\"position\":\"Freelance Creative Frontend Developer\"}]}]}]},{\"year\":2025,\"modules\":[{\"module_number\":1,\"courses\":[{\"id\":1176,\"title\":\"Intro to Cyber Security\",\"code\":\"CSEC201BKK\",\"credits\":4,\"status\":\"complete\",\"student_feedback_submitted\":true,\"start_date\":\"2025-08-18\",\"end_date\":\"2025-09-05\",\"program\":{\"id\":22,\"name\":\"Cyber Security\",\"code\":\"CSEC\",\"degree\":\"Master\",\"campus\":\"BCN\",\"duration\":1,\"credits\":90,\"credits_for_major\":60,\"credits_for_minor\":30,\"tuition_fee\":22900,\"description\":null,\"title\":\"Master of Engineering\"},\"time\":\"09:00:00\",\"classroom\":\"Interactive.Space\",\"academic_year\":\"2025\",\"module_number\":1,\"type\":null,\"result\":{\"grade\":89,\"feedback\":\"Thank you for your active work, I hope the course was useful.\"},\"teachers\":[{\"full_name\":\"Sergey Gordeychik\",\"photo\":\"https:\\/\\/student-space-storage.ams3.digitaloceanspaces.com\\/person\\/photo\\/3839\\/conversions\\/d8bcfb50-50b3-11ea-9480-c3e4cdf53b36-thumb.jpg\",\"position\":\"Product Director for Cyber Network Defense, DarkMatter\"}]}]},{\"module_number\":2,\"courses\":[{\"id\":1218,\"title\":\"Python Refresher for Masters\",\"code\":\"DS402\",\"credits\":6,\"status\":\"failed\",\"student_feedback_submitted\":true,\"start_date\":\"2025-09-29\"